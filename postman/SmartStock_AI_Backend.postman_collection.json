            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Biscuits Merendina Chocolat\",\n  \"description\": \"Génoise marocaine enrobée de chocolat\",\n  \"price\": 2.50,\n  \"costPrice\": 1.80,\n  \"quantity\": 60,\n  \"lowStockThreshold\": 15\n}",
