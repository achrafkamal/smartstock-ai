# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://smartstock:smartstock_secret@localhost:5432/smartstock_db?schema=public"

# Security
JWT_SECRET="replace_with_a_secure_random_secret_in_production"
CORS_ORIGIN="*"

# Optional initial administrator (required by npm run db:seed)
ADMIN_NAME="SmartStock Admin"
ADMIN_EMAIL="admin@smartstock.ma"
ADMIN_PASSWORD="replace_with_a_strong_password"
